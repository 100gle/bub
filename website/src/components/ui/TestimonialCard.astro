---
import Avatar from '@/components/ui/Avatar.astro';
import Icon from '@/components/ui/Icon.astro';
import type { TestimonialItem } from '@/data/landing-page';

interface Props {
  testimonial: TestimonialItem;
  accentClass: string;
}

const { testimonial, accentClass } = Astro.props;
---

<div class:list={['border border-border border-l-[3px] bg-card p-4', accentClass]}>
  <p class="text-[0.84rem] leading-relaxed text-foreground/85">{testimonial.text}</p>
  <div class="mt-3 flex items-center gap-2.5">
    {testimonial.avatar ? (
      <Avatar
        src={testimonial.avatar}
        alt=""
        size={28}
        class="relative flex h-7 w-7 shrink-0 items-center justify-center"
        fallbackClass="flex h-7 w-7 items-center justify-center text-muted-foreground/60"
        imageClass="absolute h-7 w-7 object-cover"
        fallbackIconSize={22}
      />
    ) : (
      <div class="flex h-7 w-7 shrink-0 items-center justify-center text-muted-foreground/60">
        <Icon name="circleUserRound" size={22} aria-hidden="true" />
      </div>
    )}
    <div class="min-w-0 flex-1">
      <p class="truncate text-xs font-bold text-foreground">{testimonial.name}</p>
      <p class="truncate text-[0.65rem] text-muted-foreground">{testimonial.handle}</p>
    </div>
    {testimonial.platform && <Icon name={testimonial.platform === 'x' ? 'x-twitter' : 'github'} size={12} class="shrink-0 text-muted-foreground/50" aria-hidden="true" />}
  </div>
</div>
