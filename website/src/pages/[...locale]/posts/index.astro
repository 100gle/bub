---
import { getCollection } from 'astro:content';
import {
  getPostsRssHref,
  getPostSlug,
  getStaticLocalePaths,
  useTranslations,
} from '@/i18n/utils';
import PostCard from '@/components/ui/PostCard.astro';
import Icon from '@/components/ui/Icon.astro';
import PostListLayout from '@/layouts/PostListLayout.astro';
import type { Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return getStaticLocalePaths();
}

const { locale }: Props = Astro.props;
const t = useTranslations(locale);

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((post) => post.data.locale === locale)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

---

<PostListLayout
  title={t('posts.title')}
  description={t('posts.description')}
  {locale}
>
  <header class="mb-14 flex flex-wrap items-center justify-between gap-4">
    <p class="text-muted-foreground">{t('posts.description')}</p>
    <a
      href={getPostsRssHref(locale)}
      class="inline-flex items-center gap-2 font-mono text-sm text-muted-foreground no-underline transition-colors hover:text-foreground"
    >
      <Icon name="rss" size={15} aria-hidden="true" />
      {t('posts.subscribe')}
    </a>
  </header>

  <div class="grid gap-px border border-border bg-border sm:grid-cols-2">
    {posts.map((post, i) => {
      const slug = getPostSlug(post.id, locale);
      return (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          tags={post.data.tags}
          slug={slug}
          locale={locale}
          index={i + 1}
        />
      );
    })}
  </div>
</PostListLayout>
