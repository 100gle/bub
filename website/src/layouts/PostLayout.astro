---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { StarlightPageProps } from '@astrojs/starlight/components/StarlightPage.astro';
import Icon from '@/components/ui/Icon.astro';
import {
  getAlternateLocale,
  formatPostDate,
  getHtmlLang,
  getOpenGraphLocale,
  getPostsHref,
  getPostsRssHref,
  useTranslations,
} from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  locale: Locale;
  tags: string[];
  /** Content collection source ID, e.g. "en/bootstrap-milestone". */
  sourceId: string;
  headings: MarkdownHeading[];
  sidebar: NonNullable<StarlightPageProps['sidebar']>;
}

const { title, description, date, locale, tags, sourceId, headings, sidebar }: Props = Astro.props;

const t = useTranslations(locale);
const postsHref = getPostsHref(locale);
const formattedDate = formatPostDate(date, locale);
const postId = sourceId.replace(/\.md$/, '');
const sourcePath = sourceId.endsWith('.md') ? sourceId : `${sourceId}.md`;
const ogImage = `/og/posts/${postId}.png`;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const rssUrl = new URL(getPostsRssHref(locale), Astro.site).href;
const openGraphLocale = getOpenGraphLocale(locale);
const alternateOpenGraphLocale = getOpenGraphLocale(getAlternateLocale(locale));
const editUrl = new URL(
  `/bubbuild/bub/edit/main/website/src/content/posts/${sourcePath}`,
  'https://github.com',
).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonicalUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  image: [ogImageUrl],
  datePublished: date.toISOString(),
  inLanguage: getHtmlLang(locale),
  keywords: tags,
  publisher: {
    '@type': 'Organization',
    name: 'Bub',
    url: new URL('/', Astro.site).href,
  },
};
const head: NonNullable<StarlightPageProps['frontmatter']['head']> = [
  { tag: 'meta', attrs: { property: 'og:type', content: 'article' } },
  { tag: 'meta', attrs: { property: 'og:locale', content: openGraphLocale } },
  { tag: 'meta', attrs: { property: 'og:locale:alternate', content: alternateOpenGraphLocale } },
  { tag: 'meta', attrs: { property: 'og:title', content: `${title} | Bub` } },
  { tag: 'meta', attrs: { property: 'og:image', content: ogImageUrl } },
  { tag: 'meta', attrs: { property: 'og:image:alt', content: title } },
  { tag: 'meta', attrs: { property: 'og:image:width', content: '1200' } },
  { tag: 'meta', attrs: { property: 'og:image:height', content: '630' } },
  { tag: 'meta', attrs: { property: 'article:published_time', content: date.toISOString() } },
  ...tags.map((tag) => ({
    tag: 'meta' as const,
    attrs: { property: 'article:tag', content: tag },
  })),
  { tag: 'meta', attrs: { name: 'twitter:title', content: `${title} | Bub` } },
  { tag: 'meta', attrs: { name: 'twitter:description', content: description } },
  { tag: 'meta', attrs: { name: 'twitter:image', content: ogImageUrl } },
  { tag: 'meta', attrs: { name: 'twitter:image:alt', content: title } },
  {
    tag: 'link',
    attrs: {
      rel: 'alternate',
      type: 'application/rss+xml',
      title: `Bub — ${t('posts.title')}`,
      href: rssUrl,
    },
  },
  {
    tag: 'script',
    attrs: { type: 'application/ld+json' },
    content: JSON.stringify(jsonLd).replace(/</g, '\\u003c'),
  },
];
---

<StarlightPage
  frontmatter={{
    title,
    description,
    editUrl,
    head,
  }}
  {headings}
  {sidebar}
  hasSidebar={false}
>
  <div class="not-content mb-10 border-b border-border pb-8" data-pagefind-ignore>
    <a
      href={postsHref}
      class="mb-8 inline-flex items-center gap-2 font-mono text-sm text-muted-foreground no-underline transition-colors duration-300 hover:text-foreground"
    >
      <Icon name="arrowLeft" size={14} aria-hidden="true" />
      {t('posts.back')}
    </a>
    <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
      <time class="font-mono text-muted-foreground" datetime={date.toISOString()}>
        {formattedDate}
      </time>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="border border-border px-1.5 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-muted-foreground">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>

  <slot />
</StarlightPage>
