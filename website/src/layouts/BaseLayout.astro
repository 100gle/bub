---
/**
 * BaseLayout.astro — shared HTML shell for custom pages.
 *
 * Provides: <!doctype>, <head> (meta, OG, favicon, inline theme init),
 * <body> with NavBar, <slot/> for main content, Footer, and
 * the scroll-reveal + back-to-top scripts.
 *
 * Landing pages and the standalone 404 compose on top of this. Docs and
 * blog pages use Starlight's shell.
 */
import '@/styles/site.css';
import Footer from '@/components/Footer.astro';
import NavBar from '@/components/NavBar.astro';
import Icon from '@/components/ui/Icon.astro';
import ScrollReveal from '@/components/ui/ScrollReveal.astro';
import {
  getHtmlLang,
  getLangFromUrl,
  getNavProps,
  getOpenGraphLocale,
  useTranslations,
  type NavProps,
} from '@/i18n/utils';
import { getRepoStats } from '@/lib/github';

interface Props {
  /** Page <title>. Falls back to site.title from ui.ts. */
  title?: string;
  /** Meta description. Falls back to site.description from ui.ts. */
  description?: string;
  /** Canonical URL. If not set, omitted from head. */
  canonicalUrl?: string;
  /** Localized equivalents of this page. */
  alternateLinks?: Array<{ href: string; hreflang: string }>;
  /** OG type. Defaults to 'website'. */
  ogType?: string;
  /** OG image path (relative to site root, e.g. '/og/index.png'). */
  ogImage?: string;
  /** Extra class on <body>. */
  bodyClass?: string;
  /** Whether to render the back-to-top button. Default true. */
  backToTop?: boolean;
  /** Whether to render the skip-to-content link. Default true. */
  skipLink?: boolean;
  /** Override nav props (rare — only if you need a custom nav). */
  navOverrides?: Partial<NavProps>;
  /** robots meta. */
  robots?: string;
}

const locale = getLangFromUrl(Astro.url);
const htmlLang = getHtmlLang(locale);
const openGraphLocale = getOpenGraphLocale(locale);
const t = useTranslations(locale);
const navProps = { ...getNavProps(locale, Astro.url.pathname), ...(Astro.props.navOverrides ?? {}) };
const footerCopyright = `© ${new Date().getUTCFullYear()} Bub Contributors`;

const { starsFormatted: stars } = getRepoStats();

const {
  title = t('site.title'),
  description = t('site.description'),
  canonicalUrl,
  alternateLinks = [],
  ogType = 'website',
  ogImage = '/og/index.png',
  bodyClass = 'min-h-screen antialiased font-sans',
  backToTop = true,
  skipLink = true,
  robots,
} = Astro.props;

if (!Astro.site) throw new Error('Astro site URL must be configured.');
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#252525" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternateLinks.map(({ href, hreflang }) => <link rel="alternate" {href} {hreflang} />)}
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content="Bub" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('starlight-theme');
        const followsSystem = stored === null || stored === 'auto';
        const dark = stored === 'dark' || (followsSystem && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      })();
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {skipLink && (
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-primary focus:text-primary-foreground focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
      >
        {t('a11y.skip')}
      </a>
    )}

    <NavBar {...navProps} stars={stars} />

    <slot />

    <Footer copyright={footerCopyright} githubLabel={navProps.githubLabel} homeHref={navProps.homeHref} />

    <ScrollReveal />

    {backToTop && (
      <button
        id="back-to-top"
        class="fixed right-4 bottom-[max(5rem,env(safe-area-inset-bottom))] z-50 flex h-9 w-9 cursor-pointer items-center justify-center border border-border bg-background/95 text-foreground opacity-0 backdrop-blur-sm transition-all duration-300 hover:bg-secondary pointer-events-none sm:bottom-6 sm:right-6 sm:h-10 sm:w-10"
        aria-label={t('a11y.backToTop')}
        type="button"
      >
        <Icon name="chevronUp" size={16} aria-hidden="true" />
      </button>
    )}

    <script>
      type BaseLayoutWindow = Window & {
        __bubBaseLayoutPageLoadBound?: boolean;
        __bubBackToTopCleanup?: () => void;
      };

      function initBackToTop() {
        const baseLayoutWindow = window as BaseLayoutWindow;
        baseLayoutWindow.__bubBackToTopCleanup?.();
        baseLayoutWindow.__bubBackToTopCleanup = undefined;

        const btn = document.getElementById('back-to-top') as HTMLButtonElement | null;
        if (!btn) return;

        const toggle = () => {
          const show = window.scrollY > 400;
          btn.style.opacity = show ? '1' : '0';
          btn.style.pointerEvents = show ? 'auto' : 'none';
        };

        const handleClick = () => {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
        };

        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        btn.addEventListener('click', handleClick);

        baseLayoutWindow.__bubBackToTopCleanup = () => {
          window.removeEventListener('scroll', toggle);
          btn.removeEventListener('click', handleClick);
        };
      }

      function initBaseLayoutUi() {
        requestAnimationFrame(initBackToTop);
      }

      const baseLayoutWindow = window as BaseLayoutWindow;

      initBaseLayoutUi();
      if (!baseLayoutWindow.__bubBaseLayoutPageLoadBound) {
        document.addEventListener('astro:page-load', initBaseLayoutUi);
        baseLayoutWindow.__bubBaseLayoutPageLoadBound = true;
      }
    </script>
  </body>
</html>
